# Doxyfile - R-Type ECS Engine Documentation
# Generated for Doxygen 1.9+

#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------

PROJECT_NAME           = "R-Type ECS Engine"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "A high-performance Entity Component System game engine with multiplayer support"
PROJECT_LOGO           = 

OUTPUT_DIRECTORY       = doc/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO

OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = src/
SHORT_NAMES            = NO

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO

TAB_SIZE               = 4

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Custom aliases for ECS documentation
ALIASES                = "ecscomponent=@par ECS Component:\n" \
                         "ecssystem=@par ECS System:\n" \
                         "ecsregistry=@par Uses Registry:\n" \
                         "eventbus=@par EventBus Integration:\n" \
                         "thread_safe=@par Thread Safety:\n This class/function is thread-safe." \
                         "not_thread_safe=@par Thread Safety:\n This class/function is NOT thread-safe." \
                         "performance=@par Performance Notes:\n" \
                         "usage=@par Usage Example:\n" \
                         "raylib=@par raylib Integration:\n"

